# Coolify deployment variables for docker-compose.yml.
#
# How to use:
#   1. In Coolify, create a new resource: Project -> + Resource ->
#      "Docker Compose (Build Pack)" pointing at this repository.
#   2. Open the resource's "Environment Variables" page, switch to
#      "Developer view", paste this file, fill in the secrets and save.
#   3. Deploy. Coolify auto-generates the public URL of the frontend via the
#      SERVICE_FQDN_FRONTEND_3000 magic variable (wildcard domain of the
#      server). The backend stays private (no domain, no published ports).
#
# Only variables marked with "(?)" in docker-compose.yml are strictly
# required: OPENROUTER_API_KEY, TARGET_HOST, TARGET_URL, ALLOWED_TARGETS.

# --- LLM (OpenRouter) — REQUIRED ---
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=tencent/hy3
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# --- Optional LangSmith tracing ---
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=pentest-agents

# --- Runtime ---
LOG_LEVEL=INFO

# --- Authorized target configuration — REQUIRED ---
TARGET_HOST=clinic.72-61-136-120.nip.io
TARGET_URL=https://clinic.72-61-136-120.nip.io
TARGET_USERNAME=demo
TARGET_PASSWORD=your-password-here
TARGET_ADMIN_USERNAME=admin
TARGET_ADMIN_PASSWORD=your-admin-password-here

# --- Centralized scope policy — ALLOWED_TARGETS is REQUIRED ---
ALLOWED_TARGETS=["clinic.72-61-136-120.nip.io"]
# DENIED_TARGETS=["*.gov","*.bank"]
RESEARCH_ALLOWED_TARGETS=["clinic.72-61-136-120.nip.io"]
NMAP_ALLOWED_TARGETS=["clinic.72-61-136-120.nip.io"]
EXPLOIT_ALLOWED_TARGETS=["clinic.72-61-136-120.nip.io"]
BLOCK_PRIVATE_IPS=true

# --- Exploitation simulation safety ---
EXPLOIT_EXECUTE=false
EXPLOIT_SANDBOX=true

# --- Nmap (containerized via the host Docker daemon) ---
NMAP_MOCK=false
NMAP_USE_DOCKER=true
NMAP_DOCKER_IMAGE=instrumentisto/nmap
NMAP_DOCKER_NETWORK=host
NMAP_POLICY=safe

# --- Python sandbox ---
PYTHON_USE_DOCKER=true
PYTHON_DOCKER_IMAGE=python:3.12-slim

# --- Research browser ---
RESEARCH_MOCK=false

# --- OSINT tools ---
OSINT_MOCK=false
CENSYS_API_ID=
CENSYS_API_SECRET=
CHAOS_API_KEY=
VIRUSTOTAL_API_KEY=
SECURITYTRAILS_API_KEY=
IPINFO_TOKEN=
