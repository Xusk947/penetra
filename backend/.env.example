# Copy to .env and fill in real values.

# OpenAI (used for future LLM-based analysis nodes)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Runtime
LOG_LEVEL=INFO

# Authorized target configuration
TARGET_HOST=clinic.72-61-136-120.nip.io
TARGET_URL=https://clinic.72-61-136-120.nip.io
TARGET_USERNAME=demo
TARGET_PASSWORD=your-password-here
TARGET_ADMIN_USERNAME=admin
TARGET_ADMIN_PASSWORD=your-admin-password-here

# Centralized scope policy
ALLOWED_TARGETS=["clinic.72-61-136-120.nip.io"]
# DENIED_TARGETS=["*.gov","*.bank"]
RESEARCH_ALLOWED_TARGETS=["clinic.72-61-136-120.nip.io"]
NMAP_ALLOWED_TARGETS=["clinic.72-61-136-120.nip.io"]
EXPLOIT_ALLOWED_TARGETS=["clinic.72-61-136-120.nip.io"]
BLOCK_PRIVATE_IPS=true

# Exploitation simulation safety
EXPLOIT_EXECUTE=false
EXPLOIT_SANDBOX=true

# OpenRouter LLM
OPENROUTER_API_KEY=
OPENROUTER_MODEL=tencent/hy3:free
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Nmap
NMAP_MOCK=false
NMAP_USE_DOCKER=true
NMAP_DOCKER_IMAGE=instrumentisto/nmap
NMAP_DOCKER_NETWORK=host
NMAP_POLICY=safe

# Python sandbox
PYTHON_USE_DOCKER=true
PYTHON_DOCKER_IMAGE=python:3.12-slim

# E2E test configuration
E2E_SCOPE=["clinic.72-61-136-120.nip.io"]
E2E_DENIED_TARGET=10.0.0.1
RESEARCH_URL=https://clinic.72-61-136-120.nip.io
OSINT_TARGET=clinic.72-61-136-120.nip.io

# Research browser
RESEARCH_MOCK=false

# OSINT tools
OSINT_MOCK=false
CENSYS_API_ID=
CENSYS_API_SECRET=
CHAOS_API_KEY=
VIRUSTOTAL_API_KEY=
SECURITYTRAILS_API_KEY=
IPINFO_TOKEN=
